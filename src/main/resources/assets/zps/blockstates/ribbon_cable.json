{
  "multipart": [
    { "when": { "orientation": "north_south" },     "apply": { "model": "zps:block/ribbon_straight" } },
    { "when": { "orientation": "north_south_alt" }, "apply": { "model": "zps:block/ribbon_straight_alt" } },
    { "when": { "orientation": "east_west" },       "apply": { "model": "zps:block/ribbon_straight", "y": 90 } },
    { "when": { "orientation": "east_west_alt" },   "apply": { "model": "zps:block/ribbon_straight_alt", "y": 90 } },
    { "when": { "orientation": "up_down" },         "apply": { "model": "zps:block/ribbon_straight", "x": 90 } },
    { "when": { "orientation": "up_down_alt" },     "apply": { "model": "zps:block/ribbon_straight_alt", "x": 90 } },

    { "when": { "orientation": "west_north" },      "apply": { "model": "zps:block/ribbon_bend" } },
    { "when": { "orientation": "north_east" },      "apply": { "model": "zps:block/ribbon_bend", "y": 90 } },
    { "when": { "orientation": "east_south" },      "apply": { "model": "zps:block/ribbon_bend", "y": 180 } },
    { "when": { "orientation": "south_west" },      "apply": { "model": "zps:block/ribbon_bend", "y": 270 } },
    { "when": { "orientation": "up_west" },         "apply": { "model": "zps:block/ribbon_bend", "x": 270 } },
    { "when": { "orientation": "up_north" },        "apply": { "model": "zps:block/ribbon_bend", "x": 270, "y": 90 } },
    { "when": { "orientation": "up_east" },         "apply": { "model": "zps:block/ribbon_bend", "x": 270, "y": 180 } },
    { "when": { "orientation": "up_south" },        "apply": { "model": "zps:block/ribbon_bend", "x": 270, "y": 270 } },
    { "when": { "orientation": "down_west" },       "apply": { "model": "zps:block/ribbon_bend", "x": 90 } },
    { "when": { "orientation": "down_north" },      "apply": { "model": "zps:block/ribbon_bend", "x": 90, "y": 90 } },
    { "when": { "orientation": "down_east" },       "apply": { "model": "zps:block/ribbon_bend", "x": 90, "y": 180 } },
    { "when": { "orientation": "down_south" },      "apply": { "model": "zps:block/ribbon_bend", "x": 90, "y": 270 } },

    { "when": { "orientation": "west_north_alt" },  "apply": { "model": "zps:block/ribbon_bend_alt" } },
    { "when": { "orientation": "north_east_alt" },  "apply": { "model": "zps:block/ribbon_bend_alt", "y": 90 } },
    { "when": { "orientation": "east_south_alt" },  "apply": { "model": "zps:block/ribbon_bend_alt", "y": 180 } },
    { "when": { "orientation": "south_west_alt" },  "apply": { "model": "zps:block/ribbon_bend_alt", "y": 270 } },
    { "when": { "orientation": "up_west_alt" },     "apply": { "model": "zps:block/ribbon_bend_alt", "x": 270 } },
    { "when": { "orientation": "up_north_alt" },    "apply": { "model": "zps:block/ribbon_bend_alt", "x": 270, "y": 90 } },
    { "when": { "orientation": "up_east_alt" },     "apply": { "model": "zps:block/ribbon_bend_alt", "x": 270, "y": 180 } },
    { "when": { "orientation": "up_south_alt" },    "apply": { "model": "zps:block/ribbon_bend_alt", "x": 270, "y": 270 } },
    { "when": { "orientation": "down_west_alt" },   "apply": { "model": "zps:block/ribbon_bend_alt", "x": 90 } },
    { "when": { "orientation": "down_north_alt" },  "apply": { "model": "zps:block/ribbon_bend_alt", "x": 90, "y": 90 } },
    { "when": { "orientation": "down_east_alt" },   "apply": { "model": "zps:block/ribbon_bend_alt", "x": 90, "y": 180 } },
    { "when": { "orientation": "down_south_alt" },  "apply": { "model": "zps:block/ribbon_bend_alt", "x": 90, "y": 270 } }
  ]
}
